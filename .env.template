# ==============================================================================
# Portfolio Integration Pipeline - Environment Configuration Template
# Copy this file to '.env' and fill in your credentials/addresses.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. General Configuration
# ------------------------------------------------------------------------------
# Custom data directory path for storing fetched raw, curated, and final portfolios.
# Default: repo_root/data
PORTFOLIO_DATA_DIR=

# ------------------------------------------------------------------------------
# 2. KSEI (Indonesian Securities) Scraper Configuration
# ------------------------------------------------------------------------------
KSEI_USERNAME=your_ksei_username_here
KSEI_PASSWORD=your_ksei_password_here

# Optional configuration (uncomment if you wish to override defaults)
# KSEI_AUTH_PATH=./auth
# KSEI_OUTPUT_DIR=
# KSEI_WRITE_OUTPUT=1

# ------------------------------------------------------------------------------
# 3. DeBank Scraper Configuration (DeFi Portfolio)
# ------------------------------------------------------------------------------
# The EVM wallet address to scrape DeFi portfolio details for.
EVM_ADDRESS=your_evm_wallet_address_here

# ------------------------------------------------------------------------------
# 4. Binance Client Configuration (Crypto Exchange)
# ------------------------------------------------------------------------------
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here

# Tokocrypto (optional / commented out in client but supported)
# TKO_API_KEY=your_tokocrypto_api_key_here
# TKO_SECRET=your_tokocrypto_secret_here

# ------------------------------------------------------------------------------
# 5. Solana Client Configuration (Solana Blockchain)
# ------------------------------------------------------------------------------
SOLANA_WALLET_ADDRESS=your_solana_wallet_address_here

# Optional: RPC node URL (default: https://api.mainnet-beta.solana.com)
# RPC_URL=https://api.mainnet-beta.solana.com

# ------------------------------------------------------------------------------
# 6. Alchemy Client Configuration (Solana Token Holdings)
# ------------------------------------------------------------------------------
# The Solana wallet address to check token holdings for.
WALLET_ADDRESS=your_solana_wallet_address_here
ALCHEMY_API_KEY=your_alchemy_api_key_here

# ------------------------------------------------------------------------------
# 7. Hyperliquid Configuration (L1 Perp/Vault/Spot Exchange)
# ------------------------------------------------------------------------------
# The EVM wallet address to fetch Hyperliquid vault/equities positions for.
HYPERLIQUID_WALLET_ADDRESS=your_evm_wallet_address_here

# ------------------------------------------------------------------------------
# 8. Qazwa Scraper Configuration (P2P Lending Portfolio)
# ------------------------------------------------------------------------------
QAZWA_EMAIL=your_qazwa_email_here
QAZWA_PASSWORD=your_qazwa_password_here
